{
  "name": "just-translate",
  "version": "0.3.38",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "A local-first bilingual webpage translator with free Google/Microsoft channels and optional custom AI.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "eslint . && vitest run && tsc --noEmit && vite build && node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@streamparser/json": "0.0.26",
    "eventsource-parser": "4.1.0",
    "i18next": "26.4.2",
    "idb": "8.0.3",
    "lucide-react": "1.34.0",
    "p-queue": "9.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.14",
    "tinyld": "1.3.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "9.39.5",
    "@types/chrome": "0.2.7",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "globals": "17.11.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
